#ifndef ALFA_ETHERNET_USER_CLIENT_IIG
#define ALFA_ETHERNET_USER_CLIENT_IIG

#include <DriverKit/IOUserClient.iig>

class AlfaEthernetUserClient : public IOUserClient {
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual kern_return_t ExternalMethod(uint64_t selector, IOUserClientMethodArguments *arguments,
        const IOUserClientMethodDispatch *dispatch, OSObject *target, void *reference) override;
    virtual kern_return_t CopyClientMemoryForType(uint64_t type, uint64_t *options, IOMemoryDescriptor **memory) override;
    virtual bool Authorize() LOCALONLY;
};

#endif
